# 클라이언트 번들에 들어가는 값은 VITE_ 접두어만. 공개돼도 되는 anon(publishable) 키만 넣는다.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# 카카오·구글 로그인 버튼 노출 (Supabase 대시보드에서 provider를 켠 뒤 true)
VITE_OAUTH_KAKAO=false
VITE_OAUTH_GOOGLE=false

# ---- 아래는 절대 VITE_ 접두어를 붙이지 말 것 (서버 전용) ----
# RLS 통합 테스트용 (npm run test:rls). .env.test 에 둔다.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Edge Function 시크릿: supabase secrets set ANTHROPIC_API_KEY=...
